# Django Configuration — copy this file to .env and fill in the values.
# Do NOT commit your actual .env file to version control.

# Set DB_HOST empty to use SQLite locally; set to 'db' for Docker.
DB_HOST=

# PostgreSQL credentials (required when DB_HOST is set)
POSTGRES_DB=notepad_db
POSTGRES_USER=<your_postgres_user>
POSTGRES_PASSWORD=<your_postgres_password>
POSTGRES_PORT=5432

# Django settings
DJANGO_SECRET_KEY=<replace-with-real-secret-key>
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# The LAN helper supplies the current host IPv4 automatically; do not hardcode it here.
DJANGO_DEBUG=true
